<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Zapret" Width="380" Height="710" MinWidth="380" MaxWidth="380" MinHeight="710" MaxHeight="710" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#0B0B0D" Foreground="#F0F2F4" FontFamily="pack://application:,,,/Zapret;component/fonts/#PT Root UI VF" FontSize="15" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A3A3AD"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DDE2E6"/><Setter Property="Background" Value="#202025"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FFAD58"/><Setter Property="Foreground" Value="#2A190B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9AA2AA"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,2"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101416"/><Setter Property="Foreground" Value="#DDE2E6"/><Setter Property="CaretBrush" Value="#FFAD58"/><Setter Property="BorderBrush" Value="#343B42"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="#3E7158"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
