    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#85858F" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid></Border><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocused" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></MultiTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#6A6A76"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
