    </Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
   <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch">
